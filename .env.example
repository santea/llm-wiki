# OpenAI-compatible LLM Server Configuration
# Supports official OpenAI API, vLLM, Ollama, LocalAI, OpenRouter, Groq, LM Studio, etc.
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_API_KEY="your-openai-or-custom-api-key"
OPENAI_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
LLM_PROVIDER="openai" # "openai" | "gemini"

# (Optional / Fallback) Google Gemini API Configuration
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PostgreSQL / PgBouncer connection config (Optional for external Docker/Cloud SQL)
POSTGRES_USER="obsidian"
POSTGRES_PASSWORD="slate_secure_pass"
POSTGRES_DB="knowledge_vault"
POSTGRES_PORT="5432"
DATABASE_URL="postgresql://obsidian:slate_secure_pass@localhost:5432/knowledge_vault"
